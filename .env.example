# ---- network ----
# local | arc-testnet
AGENTMESH_NETWORK=local
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# ---- wallets (EOA path) ----
# demo:local ignores these (uses anvil's default accounts)
BUYER_PRIVATE_KEY=
SELLER_PRIVATE_KEY=
WATCHER_PRIVATE_KEY=
DASHBOARD_PRIVATE_KEY=

# ---- Circle Developer-Controlled Wallets (optional; flips the wallet layer) ----
# WALLET_PROVIDER=circle
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=

# ---- Circle Compliance Engine (optional; watcher falls back to local allowlist) ----
CIRCLE_COMPLIANCE_API_KEY=
# comma-separated addresses to block in fallback screening mode
DENYLIST=

# ---- services ----
SELLER_URL=http://localhost:4021
# Port for the seller agent (default 4021) and watcher poll interval ms (default 2000)
# PORT=4021
# POLL_MS=2000

# ---- dashboard action auth ----
# Bearer token required by POST /api/action (extension stores the same token).
# Optional on local; REQUIRED on any non-local network.
DASHBOARD_ACTION_TOKEN=

# ---- deployment address overrides (usually read from deployments/<network>.json) ----
# USDC_ADDRESS=
# AGENT_REGISTRY_ADDRESS=
# COMPLIANCE_GATE_ADDRESS=
# AGENT_ESCROW_ADDRESS=
# DISPUTE_WINDOW=300
# LOCAL_RPC_URL=http://127.0.0.1:8545
