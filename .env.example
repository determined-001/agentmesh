# ---- network ----
# local | arc-testnet
AGENTMESH_NETWORK=local
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
# ARC_TESTNET_EXPLORER_URL=https://testnet.arcscan.app
# Arc Testnet canonical USDC ERC-20 (6dp). Pass to Deploy.s.sol on testnet:
# USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ---- wallets (EOA path) ----
# demo:local ignores these (uses anvil's default accounts)
BUYER_PRIVATE_KEY=
SELLER_PRIVATE_KEY=
WATCHER_PRIVATE_KEY=
DASHBOARD_PRIVATE_KEY=

# ---- Circle Developer-Controlled Wallets (optional; flips the wallet layer) ----
# WALLET_PROVIDER=circle
# One API key/entity secret covers all wallets. Each role needs its own
# CIRCLE_<ROLE>_WALLET_ID/ADDRESS (services share this .env, so a single
# unprefixed pair would give every role the same wallet). DASHBOARD usually
# mirrors BUYER. Generate via `pnpm circle:setup entity-secret` then
# `pnpm circle:setup wallets`.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_BUYER_WALLET_ID=
CIRCLE_BUYER_WALLET_ADDRESS=
CIRCLE_SELLER_WALLET_ID=
CIRCLE_SELLER_WALLET_ADDRESS=
CIRCLE_WATCHER_WALLET_ID=
CIRCLE_WATCHER_WALLET_ADDRESS=
CIRCLE_DASHBOARD_WALLET_ID=
CIRCLE_DASHBOARD_WALLET_ADDRESS=

# ---- Circle Compliance Engine (optional; watcher falls back to local allowlist) ----
CIRCLE_COMPLIANCE_API_KEY=
# comma-separated addresses to block in fallback screening mode
DENYLIST=

# ---- services ----
SELLER_URL=http://localhost:4021
# Port for the seller agent (default 4021) and watcher poll interval ms (default 2000)
# PORT=4021
# POLL_MS=2000

# Operator-only seller routes (/payments, /jobs) — they expose every payer
# address, amount and tx hash. Required off-local; the dashboard sends it
# server-side so it never reaches a browser.
SELLER_ADMIN_TOKEN=
# Comma-separated origins allowed to call the priced API cross-origin.
# Empty = "*", which is fine for a public priced API but set it if you can.
# CORS_ORIGINS=https://your-dashboard.example
# Per-IP token bucket on the seller's public routes.
# RATE_LIMIT_RPS=10
# RATE_LIMIT_BURST=30
# Set to 1 ONLY behind a proxy you control, so X-Forwarded-For can be trusted.
# TRUST_PROXY=0
# Seconds the dashboard caches /api/state (shields the RPC from per-tab polling).
# STATE_CACHE_MS=2000

# ---- x402 client spend limits ----
# Hard ceilings enforced inside paidFetch. The MCP server clamps the model's
# requested per-call cap to X402_MAX_PER_CALL_USD, and X402_MAX_TOTAL_USD caps
# the process lifetime — a prompt-injected page cannot raise either.
# X402_MAX_PER_CALL_USD=0.10
# X402_MAX_TOTAL_USD=10

# ---- dashboard action auth ----
# Bearer token required by POST /api/action (extension stores the same token).
# This route SIGNS transactions with DASHBOARD_PRIVATE_KEY, so it fails closed:
# with no token set the endpoint rejects everything, including when
# AGENTMESH_NETWORK is unset. Always set this off-local.
DASHBOARD_ACTION_TOKEN=
# Escape hatch for local demos only: serves /api/action WITHOUT authentication.
# Honoured solely when AGENTMESH_NETWORK=local. Never set this anywhere else.
# DASHBOARD_ALLOW_UNAUTHENTICATED=1

# ---- deployment address overrides (usually read from deployments/<network>.json) ----
# USDC_ADDRESS=
# AGENT_REGISTRY_ADDRESS=
# COMPLIANCE_GATE_ADDRESS=
# AGENT_ESCROW_ADDRESS=
# DISPUTE_WINDOW=300
# Seconds after delivery before anyone may refund a stuck job. Must exceed
# DISPUTE_WINDOW. Default 604800 (7 days).
# RESOLVE_TIMEOUT=604800
# LOCAL_RPC_URL=http://127.0.0.1:8545

# ---- deploy-time role separation (see docs/DEPLOYMENT.md) ----
# Use three DISTINCT wallets. Only SCREENER_ADDRESS needs to be online — it is
# the watcher's key. Arbiter and gate admin should be cold.
# ARBITER_ADDRESS=
# GATE_ADMIN_ADDRESS=
# SCREENER_ADDRESS=
# GATE_ADMIN_DELAY=172800
# VERDICT_TTL=86400
