{
  "manifest_version": 3,
  "name": "AgentMesh Companion",
  "version": "0.1.0",
  "description": "Human oversight for your AI agents on Arc: balances, escrow approvals, disputes.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AgentMesh"
  },
  "host_permissions": ["http://localhost:3000/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
